{
  "name": "blog-api",
  "version": "1.0.0",
  "private": true,
  "description": "Blog API on Parse Server + Express",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 test/",
    "lint": "eslint .",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^7.7.0",
    "parse-server": "^9.10.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
